# Environments
venv/
venv_wsl/
.env

# Models & Data
# Trained models ARE versioned — autopilot commits them daily when the quality
# gate accepted a change (~6 MB/snapshot, no commit on unchanged cycles).
saved_models/*
!saved_models/*.keras
!saved_models/*.pt
!saved_models/*.pkl
!saved_models/*.json
saved_models/.training_lock
data/prep/
data/datasets/*.csv
data/datasets/*.json
*.db
logs/*
!logs/ensemble_eval.json
!logs/training_results.json
# Research + honesty artifacts: served to the frontend, so they must
# travel with the code rather than living only on the training machine.
!logs/tradeability.json
!logs/btc_research.json
!logs/propagation_validation.json
!logs/robustness.json
!logs/original_methods.json
!logs/bulletproof.json

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# Local venv (uv)
.venv/

# Experiment caches & backups
data/backups/
data/exp_frames_cache.pkl
data/fred_cache.json
# Replay buffers: ~90 MB, machine-local, and regenerated automatically from
# data/prep on first autopilot cycle (see _seed_replay_from_prep).
data/replay_*.pkl
data/.replay_seeded
*.db-shm
*.db-wal
