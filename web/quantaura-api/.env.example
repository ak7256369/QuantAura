# Copy to .env — this file documents every variable the API and the bot read.
# .env lives on the VPS only and is never committed.

# ── core API (server.js) ────────────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/quantaura
JWT_SECRET=change-me-long-random-string
ADMIN_EMAIL=admin@quantaura.tech
ADMIN_PASSWORD=change-me
ML_API_URL=http://localhost:5051

# ── Telegram integration ────────────────────────────────────────────────────
# The bot itself lives in its own repo (quantaura-telegram-bot) with its own
# .env. This API only needs the bot's public @name (WITHOUT the @) to build
# the one-tap pairing deep link on the account page. Leaving it unset hides
# the "Connect Telegram" card entirely — it doubles as the feature flag.
TELEGRAM_BOT_USERNAME=

# ── Paper portfolio (/api/portfolio) ────────────────────────────────────────
# Fine-grained GitHub PAT, contents:read on ak7256369/quantaura-youtube only —
# the channel's committed scoreboard is the single source for the portfolio
# page. Unset, the route reports pending and the page shows a coming-soon
# state rather than an error.
SCOREBOARD_TOKEN=
