{
  "appId": "tech.quantaura.widget",
  "productName": "QuantAura Widget",
  "copyright": "Copyright © 2026 Abuzar (QuantAura)",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/assets/icon.png",
    "artifactName": "QuantAura-Widget-Setup-${version}.exe"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "QuantAura Widget",
    "installerIcon": "public/assets/icon.png",
    "uninstallerIcon": "public/assets/icon.png"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "public/assets/icon.icns",
    "category": "public.app-category.finance"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "public/assets/icon.png",
    "category": "Finance"
  }
}
