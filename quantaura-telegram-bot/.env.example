# Copy to .env on the VPS. Never committed.

# ── shared with quantaura-api (must be the SAME values) ─────────────────────
# The bot lives in its own repo but shares the product's database and trusts
# relationship: it reads/writes the users collection directly and self-signs
# service JWTs that quantaura-api verifies.
MONGODB_URI=mongodb://127.0.0.1:27017/quantaura
JWT_SECRET=same-value-as-quantaura-api

# ── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather. Required.
TELEGRAM_BOT_TOKEN=
# The bot's public @name WITHOUT the @. quantaura-api needs the same value in
# its own .env (TELEGRAM_BOT_USERNAME) to build the account page's deep link.
TELEGRAM_BOT_USERNAME=
# Public free-funnel channel (@name or -100... id); bot must be admin there.
# Unset = no public posts; premium DMs unaffected.
TELEGRAM_FREE_CHANNEL_ID=

# ── behaviour ───────────────────────────────────────────────────────────────
# Where the bot reads signals — quantaura-api's public HTTP contract. REQUIRED,
# and deliberately not defaulted: this VPS hosts unrelated sites on the nearby
# ports (5000 is one of them), so a guessed base reads a stranger's server. Use
# whatever PORT quantaura-api/.env sets — 5001 at the time of writing.
BOT_API_BASE=http://127.0.0.1:5001
# Premium account whose view the bot reads. Default: the seeded admin.
#BOT_SERVICE_EMAIL=
# Leave unset unless you mean to track a subset — set, this OVERRIDES the code
# default, so a stale value here is how the bot silently falls behind the site.
#BOT_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,DOTUSDT,LINKUSDT
#BOT_POLL_MINUTE=6
#BOT_DIGEST_HOUR_UTC=12
#BOT_SENDS_PER_SECOND=15
# Run every code path but print messages instead of sending:
#BOT_DRY_RUN=1
